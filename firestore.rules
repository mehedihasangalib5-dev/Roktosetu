rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validPhone(p) { return p is string && p.matches('^01[0-9]{9}$'); }
    function validGroup(g) { return g in ['A+','A-','B+','B-','O+','O-','AB+','AB-']; }
    // Optional GPS point (lat/lng must both exist and be valid numbers)
    function validLoc(d) {
      return (!('lat' in d) && !('lng' in d)) ||
        (d.lat is number && d.lng is number && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180);
    }

    // One donor profile per user (doc id = uid). Only signed-in members can read.
    match /donors/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && validGroup(request.resource.data.g)
        && validPhone(request.resource.data.ph)
        && validLoc(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins: create a doc admins/{uid} manually in the Console (clients cannot write here)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Blood banks / hospitals directory
    match /facilities/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.type in ['Blood Bank','Hospital','Voluntary Org']
        && request.resource.data.ph is string && request.resource.data.ph.size() <= 30
        && request.resource.data.get('addr', '') is string
        && request.resource.data.get('addr', '').size() <= 200
        && validLoc(request.resource.data)
        && request.resource.data.t == request.time;
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.verified == resource.data.verified
            && request.resource.data.name is string && request.resource.data.name.size() <= 120
            && request.resource.data.get('stock', {}).size() <= 8
            && validLoc(request.resource.data))
      );
      allow delete: if signedIn() && (isAdmin() || (resource.data.uid == request.auth.uid && resource.data.verified == false));
    }

    // Emergency requests
    match /requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validGroup(request.resource.data.g)
        && validPhone(request.resource.data.ph)
        && validLoc(request.resource.data)
        && request.resource.data.u is int
        && request.resource.data.u >= 1 && request.resource.data.u <= 10
        && request.resource.data.done == false
        && request.resource.data.t == request.time
        && request.resource.data.responders.size() == 0;
      allow update: if signedIn() && (
        // owner can mark fulfilled
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']))
        ||
        // any member can add only their own uid to responders
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responders'])
          && request.resource.data.responders.size() <= resource.data.responders.size() + 1
          && request.resource.data.responders.hasAll(resource.data.responders)
          && request.auth.uid in request.resource.data.responders)
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
